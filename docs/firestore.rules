rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    //  Hilfsfunktionen
    // =============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =============================================
    //  users /{userId}
    //  Nur der Besitzer liest/schreibt sein eigenes
    // =============================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();

      // Pflichtfelder bei create/update
      allow write: if request.resource.data.keys().hasAll(['phone', 'created_at'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.created_at is string; // ISO-Datumsstring
    }

    // =============================================
    //  restaurants /{restaurantId}
    //  Alle lesen, nur Admin schreiben
    // =============================================
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      allow write: if request.resource.data.keys().hasAll([
        'name_ar', 'name_en', 'category', 'phone', 'address',
        'district', 'delivery_fee', 'min_order', 'is_active', 'created_at'
      ])
        && request.resource.data.name_ar is string
        && request.resource.data.name_en is string
        && request.resource.data.category is string
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.address is string
        && request.resource.data.district is string
        && request.resource.data.delivery_fee is number
        && request.resource.data.delivery_fee >= 0
        && request.resource.data.min_order is number
        && request.resource.data.min_order >= 0
        && request.resource.data.is_active is bool
        && request.resource.data.created_at is string;
    }

    // =============================================
    //  menu_items /{itemId}
    //  Alle lesen, nur Admin schreiben
    // =============================================
    match /menu_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      allow write: if request.resource.data.keys().hasAll([
        'restaurant_id', 'name_ar', 'name_en', 'category', 'price', 'is_available'
      ])
        && request.resource.data.restaurant_id is string
        && request.resource.data.name_ar is string
        && request.resource.data.name_en is string
        && request.resource.data.category is string
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.is_available is bool;
    }

    // =============================================
    //  orders /{orderId}
    //  Eigene lesen, eigene anlegen, Status-Update nur Admin
    // =============================================
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.user_id) || isAdmin();

      // Anlegen: user_id muss mit eigenem auth.uid übereinstimmen
      allow create: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid;

      // Status-Update nur durch Admin
      allow update: if isAdmin();

      allow delete: if isAdmin();

      allow create: if request.resource.data.keys().hasAll([
        'user_id', 'restaurant_id', 'items', 'subtotal',
        'delivery_fee', 'total', 'payment_method', 'order_status',
        'delivery_address', 'customer_phone', 'created_at'
      ])
        && request.resource.data.user_id is string
        && request.resource.data.restaurant_id is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.delivery_fee is number
        && request.resource.data.delivery_fee >= 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.payment_method in ['cod', 'mobile_money']
        && request.resource.data.order_status == 'pending'
        && request.resource.data.delivery_address is map
        && request.resource.data.customer_phone is string
        && request.resource.data.created_at is string;
    }

    // =============================================
    //  reviews /{reviewId}
    //  Alle lesen, nur eigene erstellen
    // =============================================
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid;

      allow update, delete: if isOwner(resource.data.user_id) || isAdmin();

      allow write: if request.resource.data.keys().hasAll([
        'order_id', 'user_id', 'restaurant_id', 'rating', 'created_at'
      ])
        && request.resource.data.order_id is string
        && request.resource.data.user_id is string
        && request.resource.data.restaurant_id is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.created_at is string;
    }

    // =============================================
    //  promo_codes /{codeId}
    //  Nur Admin
    // =============================================
    match /promo_codes/{codeId} {
      allow read, write, delete: if isAdmin();

      allow write: if request.resource.data.keys().hasAll([
        'code', 'discount_type', 'discount_value',
        'min_order_amount', 'max_uses', 'current_uses',
        'start_date', 'end_date', 'is_active', 'created_at'
      ])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 3
        && request.resource.data.discount_type in ['percentage', 'fixed']
        && request.resource.data.discount_value is number
        && request.resource.data.discount_value > 0
        && request.resource.data.min_order_amount is number
        && request.resource.data.min_order_amount >= 0
        && request.resource.data.max_uses is number
        && request.resource.data.max_uses >= 0
        && request.resource.data.current_uses is number
        && request.resource.data.current_uses >= 0
        && request.resource.data.start_date is string
        && request.resource.data.end_date is string
        && request.resource.data.is_active is bool
        && request.resource.data.created_at is string;
    }

    // =============================================
    //  Standard: alles andere blockiert
    // =============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}